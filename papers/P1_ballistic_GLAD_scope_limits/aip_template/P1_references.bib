  volume  = {527},
  pages   = {158--163},
  doi     = {10.1016/j.tsf.2012.11.007},
  note    = {Extends the structure zone model to GLAD. Below homologous temperature
             theta = T_s/T_m approx 0.3 the microstructure is governed by atomic shadowing
             (Zone I): separated, voided, tilted columns, insensitive to the detailed
